# ==========================================================================
# Environment variables for the Natural Language Database Query tool.
# Copy this file to .env and adjust values for your environment.
# ==========================================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nlquery
POSTGRES_PASSWORD=nlquery
POSTGRES_DB=nlquery
DATABASE_URL=postgresql+psycopg2://nlquery:nlquery@localhost:5432/nlquery

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.0

# --- FAISS ---
FAISS_INDEX_DIR=./vectordb/index_store
FAISS_EMBEDDING_DIM=768
FAISS_TOP_K=5

# --- SQL Security ---
SQL_MAX_ROWS=1000
SQL_BLOCKED_KEYWORDS=DROP,DELETE,INSERT,UPDATE,ALTER,CREATE,TRUNCATE,GRANT,REVOKE,EXEC,EXECUTE

# --- Streamlit UI ---
APP_TITLE=Natural Language Database Query
