# ──────────────────────────────────────────────────────────────────
# Apigee Proxy Reporter — Environment Configuration
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.

# (Required) Apigee organisation name
APIGEE_ORG=my-apigee-org

# (Required) Authentication type:
#   "oauth" — Apigee X / hybrid (Google Cloud)  ← recommended
#   "basic" — Apigee Edge (legacy)
APIGEE_AUTH_TYPE=oauth

# ── OAuth (Apigee X / hybrid) ────────────────────────────────────
# Path to a Google Cloud service account JSON key file.
# Leave blank to use Application Default Credentials (ADC).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Basic Auth (Apigee Edge — legacy) ────────────────────────────
# Only required when APIGEE_AUTH_TYPE=basic
# APIGEE_USERNAME=your-email@example.com
# APIGEE_PASSWORD=your-password

# ── Report output options ────────────────────────────────────────
# Set to "false" to skip writing JSON or CSV files
OUTPUT_JSON=true
OUTPUT_CSV=true
